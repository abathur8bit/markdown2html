{
  "name": "VersionUtil",
  "steps": [
    {
      "name": "inc-version",
      "type": {
        "type": "version",
        "command": "versionutil",
        "params": [
        ]
      }
    },
    {
      "name": "get-version",
      "type": {
        "type": "version",
        "command": "versionutil",
        "params": [
          "-s"
        ]
      }
    },
    {
      "name": "inc-version-strict",
      "type": {
        "type": "version",
        "command": "versionutil",
        "params": [
          "--strict"
        ]
      }
    },
    {
      "name": "get-version-strict",
      "type": {
        "type": "version",
        "command": "versionutil",
        "params": [
          "-s","--strict"
        ]
      }
    },
    {
      "name": "build",
      "type": {
        "type": "execute",
        "command": "dart",
        "params": [
          "compile","exe","bin/markdown2html.dart","-o","markdown2html.exe"
        ]
      }
    },
    {
      "name": "deploy",
      "type": {
        "type": "execute",
        "command": "copy",
        "params": [
          "/Y","markdown2html.exe","\\util\\lee"
        ]
      }
    },
    {
      "name": "tag",
      "type": {
        "type": "execute",
        "command": "git",
        "params": ["tag","-a","v{{version}}","-m","Release v{{version}}"]
      }
    },
    {
      "name": "push-tag",
      "type": {
        "type": "execute",
        "command": "git",
        "params": ["push", "-f", "origin", "v{{version}}"]
      }
    }

  ]
}