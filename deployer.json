{
  "name": "VersionUtil",
  "steps": [
    {
      "name": "inc-version",
      "type": {
        "type": "version",
        "command": "versionutil",
        "params": [
          "--strict","--no-build"
        ]
      }
    },
    {
      "name": "get-version",
      "type": {
        "type": "version",
        "command": "versionutil",
        "params": [
          "-s","--strict","--no-build"
        ]
      }
    },
    {
      "name": "build",
      "type": {
        "type": "execute",
        "command": "dart",
        "params": [
          "compile","exe","bin/markdown2html.dart","-o","markdown2html.exe"
        ]
      }
    },
    {
      "name": "deploy",
      "type": {
        "type": "execute",
        "command": "copy",
        "params": [
          "/Y","markdown2html.exe","\\util\\lee"
        ]
      }
    }
  ]
}